# --- Required ---
MANTLE_RPC=https://rpc.mantle.xyz
AGENT_PK=0xyour_agent_private_key          # real mainnet key — NEVER commit
SIGNAL_REGISTRY=0x708dFb5fFea4B0149E6F1714F5A72D5291f0bB5b

# --- Telegram delivery (optional but recommended) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
DASHBOARD_URL=https://cassandra.app

# --- Tuning ---
START_BLOCK=latest                          # 'latest' = start at head, no replay
MIN_PUBLISH_SCORE=75                        # only inscribe signals scoring >= this (gas + quality)
SSE_PORT=8787                               # change if the port is taken on a shared box
